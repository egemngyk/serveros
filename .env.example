# Copy to .env (install.sh does this for you and fills in the GIDs)
SERVEROS_PORT=8080
SERVEROS_DATA=/opt/serveros/data
STACKS_DIR=/opt/serveros/stacks
DOCKER_GID=999
AGENT_GID=10001
TZ=UTC
# auto = Secure cookies when the proxy reports HTTPS (X-Forwarded-Proto). Use "true" in production behind HTTPS.
COOKIE_SECURE=auto
# Extra allowed browser origins for WebSocket/CSRF checks (comma separated), normally empty.
ALLOWED_ORIGINS=
LOG_LEVEL=info
